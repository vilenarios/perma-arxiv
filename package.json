{
  "name": "arxiv-scraper-monorepo",
  "version": "1.0.0",
  "description": "ArXiv scraper monorepo - CLI tools and web viewer",
  "private": true,
  "workspaces": [
    "packages/cli",
    "packages/web"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:cli": "npm run build --workspace=packages/cli",
    "build:web": "npm run build --workspace=packages/web",
    "dev:web": "npm run dev --workspace=packages/web",
    "cli": "node packages/cli/dist/cli.js",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules",
    "install:all": "npm install"
  },
  "keywords": [
    "arxiv",
    "scraper",
    "academic",
    "papers",
    "arweave"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
