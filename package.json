{
  "name": "arxiv-scraper",
  "version": "1.0.0",
  "description": "Robust ArXiv scraper with incremental sync capabilities",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "scrape": "tsx src/cli.ts",
    "web:bundle": "node web/bundle-duckdb.js",
    "web:deploy": "node web/deploy.js",
    "web:serve": "npx http-server web -o",
    "index:export": "node dist/cli.js index:export",
    "upload:status": "node dist/cli.js upload:status",
    "deploy:complete": "node web/smart-deploy.js",
    "deploy:test": "node test-upload.js"
  },
  "keywords": [
    "arxiv",
    "scraper",
    "academic",
    "papers"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ardrive/turbo-sdk": "^1.31.1",
    "@duckdb/duckdb-wasm": "^1.28.0",
    "axios": "^1.6.5",
    "commander": "^11.1.0",
    "dotenv": "^17.2.3",
    "duckdb": "^0.10.0",
    "fast-xml-parser": "^4.3.3",
    "p-limit": "^5.0.0",
    "p-retry": "^6.2.0",
    "parquetjs": "^0.11.2",
    "sqlite3": "^5.1.7",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.7",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
