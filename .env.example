# Arweave Configuration
# Path to your Arweave wallet JWK file
ARWEAVE_WALLET_PATH=./wallet.json

# Optional: Arweave gateway (defaults to arweave.net)
# ARWEAVE_GATEWAY=https://arweave.net

# Upload Configuration
# UPLOAD_BATCH_SIZE=10
# UPLOAD_DELAY_MS=5000

# ArXiv API Configuration
# ARXIV_API_BASE=http://export.arxiv.org/api/query
# ARXIV_PDF_BASE=https://arxiv.org/pdf

# Rate Limiting
# MAX_CONCURRENT=3
# REQUESTS_PER_SECOND=1
# RETRY_ATTEMPTS=3
# RETRY_DELAY=5000

# Storage Configuration
# BATCH_SIZE=100
# DOWNLOAD_DIR=./downloads
# DB_PATH=./arxiv.db

# User Agent (include your project URL)
# USER_AGENT=ArxivScraper/1.0.0 (https://github.com/vilenarios/perma-arxiv)

# Logging
# LOG_LEVEL=info